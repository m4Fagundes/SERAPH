{
  "_version": "1.0",
  "_timestamp": 0,
  "_comment": "Configuration template for grid-image-analyzer",
  "_instructions": "Copy this file to ~/.grid-analyzer/config.json and modify as needed",

  "performance_profile": "auto",
  "force_cpu_only": false,
  "disable_gpu": false,

  "cellpose": {
    "_comment": "Cellpose-specific settings",
    "use_gpu": true,
    "gpu_fallback_enabled": true,
    "batch_size": 1,
    "resample_factor": 1.0,
    "timeout_seconds": 300,
    "flow_threshold": 0.4,
    "cellprob_threshold": 0.0,
    "min_size": 15,
    "max_tile_size_pixels": 2000,
    "split_large_tiles": true,
    "memory_limit_mb": 2048
  },

  "threading": {
    "_comment": "Threading settings",
    "max_segmentation_threads": 2,
    "max_rendering_threads": 4,
    "use_thread_pool": true
  },

  "profiles": {
    "_comment": "Pre-defined performance profiles (for reference)",
    "low": {
      "_description": "For old hardware (<= 2 cores, <= 4GB RAM)",
      "cellpose": {
        "use_gpu": false,
        "batch_size": 1,
        "resample_factor": 0.75,
        "timeout_seconds": 180,
        "max_tile_size_pixels": 1000,
        "memory_limit_mb": 1024
      },
      "threading": {
        "max_segmentation_threads": 1,
        "max_rendering_threads": 2
      }
    },

    "medium": {
      "_description": "For modest hardware (2-4 cores, 4-8GB RAM)",
      "cellpose": {
        "use_gpu": false,
        "batch_size": 1,
        "resample_factor": 1.0,
        "timeout_seconds": 300,
        "max_tile_size_pixels": 1500,
        "memory_limit_mb": 2048
      },
      "threading": {
        "max_segmentation_threads": 2,
        "max_rendering_threads": 4
      }
    },

    "high": {
      "_description": "For reasonable hardware (4+ cores, 8+ GB RAM)",
      "cellpose": {
        "use_gpu": true,
        "batch_size": 2,
        "resample_factor": 1.0,
        "timeout_seconds": 600,
        "max_tile_size_pixels": 2000,
        "memory_limit_mb": 4096
      },
      "threading": {
        "max_segmentation_threads": 4,
        "max_rendering_threads": 8
      }
    }
  },

  "macos_monterey_overrides": {
    "_comment": "Automatic overrides for macOS Monterey 12.x",
    "_description": "These settings are automatically applied when macOS Monterey is detected",
    "force_cpu_only": true,
    "cellpose": {
      "use_gpu": false,
      "gpu_fallback_enabled": true
    }
  }
}